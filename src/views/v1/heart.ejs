<script src="/js/simpblog.min.js"></script>

<style>
  .fa-heart-o {
    color: red;
    cursor: pointer;
  }

  .fa-heart {
    color: red;
    cursor: pointer;
  }
</style>
<script>
  document.addEventListener("DOMContentLoaded", function() {
    document.getElementById("heart").addEventListener("click", function() {
      const heartElement = document.getElementById("heart");
      if (heartElement.classList.contains("liked")) {
        heartElement.innerHTML = '<i class="fa fa-heart-o" aria-hidden="true"></i>';
        heartElement.classList.remove("liked");
      } else {
        heartElement.innerHTML = '<i class="fa fa-heart" aria-hidden="true"></i>';
        heartElement.classList.add("liked");
      }
    });

    // Get a reference to the SVG element
    const heart = document.getElementById("heartIcon");

    // Add a click event listener
    heart.addEventListener("click", () => {
      // Toggle the fill color between gray and red
      if (heart.getAttribute("fill") === "gray") {
        heart.setAttribute("fill", "red");
      } else {
        heart.setAttribute("fill", "gray");
      }
    });

    class HeartIcon extends HTMLElement {
      #simpblog
      constructor() {
        super()
        this.#simpblog = new SimpBlog()
      }
      connectedCallback() {
        this.innerHTML = `
      <svg viewBox="0 0 24 24" width="100" height="100" fill="gray" style="cursor: pointer">
        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
      </svg>`
        this.addEventListener('click', this.handleClick);
      }

      disconnectedCallback() {
        // Remove the event listener when the element is removed from the DOM
        this.removeEventListener('click', this.handleClick);
      }

      handleClick(event) {
        console.log('click')
        // 3. Find the SVG *inside* this specific custom element
        const svg = this.querySelector('svg');

        // 4. Check and toggle the attribute on the Element, not the Event
        const currentFill = svg.getAttribute('fill');

        const data = this.getAttribute('data-post-id')
        const itemId = this.dataset.postId;
        console.log('item:', itemId)

        if (currentFill === 'gray') {
          svg.setAttribute('fill', 'red');
        } else {
          svg.setAttribute('fill', 'gray');
        }

        console.log('Toggled color to:', svg.getAttribute('fill'), data);

        this.#simpblog.heartPost(1)
      }
    }

    customElements.define('heart-button', HeartIcon);

  });

