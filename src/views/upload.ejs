<!DOCTYPE html>
<html>

<head>
  <title>Image Upload/Inbox/Send a Message</title>
</head>

<body>
  <h1>Upload an Image</h1>
  <form action="/upload" method="POST" enctype="multipart/form-data">
    <input type="file" name="image" accept="image/*" required>
    <button type="submit">Upload</button>
  </form>
  <form action="/upload-multiple" method="POST" enctype="multipart/form-data">
    <input type="file" name="myFiles" multiple>
    <button type="submit">Upload Files</button>
  </form>
  <textarea>Send a message</textarea>
  <% if(message){%>
  <%=message %>
  <img src='<%=imageUrl%>'>
  <% } %>

  <form action="/upload" method="POST" enctype="multipart/form-data">
    <input type="file" name="image" id="imageInput" accept="image/*" onchange="previewImage(event)">
    <img id="imagePreview" src="#" alt="Image Preview" style="display: none; max-width: 200px; max-height: 200px;">
    <button type="submit">Upload Image</button>
  </form>

  <script>
    function previewImage(event) {
      const [file] = event.target.files;
      const preview = document.getElementById('imagePreview');
      if (file) {
        // Use URL.createObjectURL to create a local URL for the image file
        preview.src = URL.createObjectURL(file);
        preview.style.display = 'block';
      } else {
        preview.style.display = 'none';
        preview.src = '#';
      }
    }
  </script>
</body>

</html>