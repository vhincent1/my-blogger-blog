{
  "name": "simpblog",
  "version": "1.0.0",
  "main": "src/app.ts",
  "type": "module",
  "author": "vhincent",
  "license": "ISC",
  "description": "",
  "scripts": {
    "start": "node --import=tsx --env-file=.env src/app.ts",
    "dev": "nodemon --watch --env-file=.env src/app.ts",
    "inspect": "nodemon --inspect --watch --env-file=.env src/app.ts",
    "api": "curl -H \"Accept: application/json\" -X GET http://localhost:3000/api/v1",
    "api:blogger": "node --import=tsx --env-file=.env src/lib/blogger.lib.js run",
    "setup": "node --import=tsx scripts/setup.ts",
    "build": "terser src/lib/simpblog.lib.js -o public/js/simpblog.min.js --compress --mangle",
    "test:database": "node --env-file=.env src/database/index.database.js",
    "test": "yarn mocha ./src/tests/*.test.ts --reporter spec"
  },
  "dependencies": {
    "@types/chai": "^5.2.3",
    "@types/chai-http": "^4.2.4",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/express-xss-sanitizer": "^2.0.0",
    "@types/mocha": "^10.0.10",
    "@types/mongo-sanitize": "^1.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.2.1",
    "async-mutex": "^0.5.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "chai": "^6.2.2",
    "chai-http": "^5.1.2",
    "chalk": "^5.6.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "crypto": "^1.0.1",
    "dotenv": "^17.2.4",
    "ejs": "^4.0.1",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.19.0",
    "express-status-monitor": "^1.3.4",
    "express-xss-sanitizer": "^2.0.1",
    "googleapis": "^171.4.0",
    "http-status-codes": "^2.3.0",
